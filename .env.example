# Telegram MTProto bot credentials (never commit real values)
API_ID=
API_HASH=
BOT_TOKEN=

# Persistent runtime data. Mount this directory in Docker.
DATA_DIR=./data
# Optional explicit Fernet key. If omitted, one is generated at DATA_DIR/.encryption_key.
# ENCRYPTION_KEY=
# ENCRYPTION_KEY_FILE=./data/.encryption_key

# FIFO queue workers. 1 = strict one-at-a-time download + upload.
MAX_PARALLEL=1
# Telegram: 1-4 per job; 3 is a good default.
TELEGRAM_DOWNLOAD_WORKERS=3
# Total active Telegram media streams across all jobs (1-8).
TELEGRAM_TOTAL_DOWNLOAD_WORKERS=6
# TeraBox parts per job (1-8).
TERABOX_UPLOAD_THREADS=6
# Total active TeraBox part uploads across all jobs (1-16).
TERABOX_TOTAL_UPLOAD_THREADS=8
TERABOX_MAX_RETRIES=8
TERABOX_CONNECT_TIMEOUT=15
TERABOX_READ_TIMEOUT=60

MAX_FILE_MB=4096
# Keep this much free space after each download reservation.
MIN_FREE_MB=512
MAX_URL_GB=10
URL_FRAGMENT_WORKERS=8
REMOTE_FOLDER=TG_Uploads
# Put each target's files in its own TeraBox subfolder.
REMOTE_FOLDER_PER_TARGET=true

# Batch engine
BATCH_CHUNK_SIZE=100
# 0 = no hard cap on a single batch.
BATCH_MAX_MESSAGES=0
# Resume jobs that were running when the process stopped.
AUTO_RESUME_BATCH=true

# Auto mode poller
AUTO_POLL_SECONDS=20

# Progress message edit interval in seconds (3-5 recommended).
PROGRESS_EDIT_INTERVAL=4
# Links list page size.
LINKS_PAGE_SIZE=10

# Keep the dashboard private unless you intentionally protect it.
LOG_WEB_HOST=127.0.0.1
LOG_WEB_PORT=8080
# LOG_WEB_TOKEN=use-a-long-random-value
